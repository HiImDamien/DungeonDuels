; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DungeonDuels"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game/game_state.gd"

[display]

window/size/viewport_width=365
window/size/viewport_height=202
window/size/mode=3
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="DungeonDuels"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[importer_defaults]

font_data_dynamic={
&"multichannel_signed_distance_field": true
}

